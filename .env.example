# Copy these settings into your local environment. Keep the actual key secret.

# Which model Brains uses: "openrouter" (cloud) or "ollama" (local, data stays on this machine).
LLM_PROVIDER=openrouter

# --- OpenRouter (cloud) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- Ollama (local) --- run `ollama serve` and `ollama pull qwen2.5:7b` first
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# Only set this if Ollama really runs on another machine you trust:
# OLLAMA_ALLOW_REMOTE=1
